---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Boim · Vibe Coder & AI Agent Practitioner',
  description = 'Web personal Boim — Vibe coding dengan OpenCode, Astro JS, Gemini & DeepSeek. Eksplorasi portofolio website modern dan artikel seputar AI-driven software development.',
  image = '/public/icon.svg',
  canonicalURL = Astro.url.href,
  type = 'website',
} = Astro.props;

const siteTitle = title.includes('Boim') ? title : `${title} · Boim`;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://boimthinks.github.io/#website',
      'url': 'https://boimthinks.github.io/',
      'name': 'Boim Thinks',
      'description': description,
    },
    {
      '@type': 'Person',
      '@id': 'https://boimthinks.github.io/#person',
      'name': 'Boim',
      'alternateName': 'boimthinks',
      'url': 'https://boimthinks.github.io/',
      'image': 'https://boimthinks.github.io/public/icon.svg',
      'jobTitle': 'Software Developer & AI Agent Practitioner',
      'sameAs': [
        'https://github.com/boimthinks',
      ],
      'knowsAbout': [
        'Astro JS',
        'Vibe Coding',
        'AI Agents',
        'OpenCode',
        'Gemini',
        'DeepSeek',
        'Web Architecture',
        'Semantic SEO',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url).href} />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen text-slate-200 antialiased font-sans selection:bg-cyan-500/20 selection:text-cyan-300">
    <div class="fixed inset-0 tech-grid-pattern pointer-events-none z-0 opacity-40"></div>
    <Navbar />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  code, pre, .font-mono {
    font-family: 'Fira Code', monospace;
  }
</style>
