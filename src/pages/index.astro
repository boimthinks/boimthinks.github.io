---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const featuredProjects = projects.filter((p) => p.featured);
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 2);
---

<BaseLayout title="Boim · Vibe Coder & AI Agent Practitioner">
  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Hero Text (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>VIBE CODING & AI AGENT ARCHITECTURE</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Membangun Web Presisi dengan <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400 bg-clip-text text-transparent">Kecerdasan AI</span>.
          </h1>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl">
            Halo! Saya <strong>Boim</strong>, seorang pengembang web dan praktisi vibe coding. Menggabungkan arsitektur ultra-cepat <strong>Astro JS</strong>, orkestrasi agent via <strong>OpenCode</strong>, serta kedalaman analisis model <strong>Gemini</strong> & <strong>DeepSeek</strong> untuk menghasilkan solusi web produksi yang berbobot.
          </p>

          <!-- Action buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/portfolio"
              class="px-5 py-2.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold text-xs sm:text-sm tracking-wide transition-all shadow-[0_0_20px_rgba(6,182,212,0.3)] hover:shadow-[0_0_25px_rgba(6,182,212,0.5)] flex items-center gap-2"
            >
              <span>Jelajahi Portofolio</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>

            <a
              href="/about"
              class="px-5 py-2.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-600 text-slate-200 text-xs sm:text-sm font-medium transition-all"
            >
              Tentang Saya
            </a>
          </div>

          <!-- Quick Stats / Badges -->
          <div class="pt-4 border-t border-slate-800/80 grid grid-cols-3 gap-4 font-mono">
            <div>
              <div class="text-xl sm:text-2xl font-bold text-white">8+</div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Live Websites</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-bold text-cyan-400">100%</div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Astro Core</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-bold text-emerald-400">OpenCode</div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Agent Harness</div>
            </div>
          </div>
        </div>

        <!-- Hero Terminal/Interactive Box (5 cols) -->
        <div class="lg:col-span-5">
          <div class="bg-slate-950/90 border border-slate-800 rounded-xl overflow-hidden shadow-2xl">
            <!-- Terminal Header -->
            <div class="px-4 py-3 bg-slate-900/80 border-b border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              </div>
              <span class="text-xs font-mono text-slate-400">boim@opencode:~</span>
              <div class="text-[10px] font-mono text-cyan-400">vibe-mode</div>
            </div>

            <!-- Terminal Body -->
            <div class="p-5 font-mono text-xs space-y-3 leading-relaxed">
              <div class="text-slate-400">
                <span class="text-emerald-400">$</span> opencode inspect profile.json
              </div>

              <div class="p-3 bg-slate-900/50 rounded border border-slate-800/60 text-slate-300 space-y-1">
                <div><span class="text-cyan-400">"developer"</span>: <span class="text-amber-300">"Boim (boimthinks)"</span>,</div>
                <div><span class="text-cyan-400">"location"</span>: <span class="text-amber-300">"Palembang, ID"</span>,</div>
                <div><span class="text-cyan-400">"primary_framework"</span>: <span class="text-amber-300">"Astro JS"</span>,</div>
                <div><span class="text-cyan-400">"preferred_models"</span>: [</div>
                <div class="pl-4 text-emerald-300">"Gemini-Flash/Pro",</div>
                <div class="pl-4 text-emerald-300">"DeepSeek-R1/V3"</div>
                <div>],</div>
                <div><span class="text-cyan-400">"agent_runtime"</span>: <span class="text-amber-300">"OpenCode CLI"</span>,</div>
                <div><span class="text-cyan-400">"status"</span>: <span class="text-emerald-400">"Active Vibe Coding"</span></div>
              </div>

              <div class="text-slate-400 pt-1">
                <span class="text-emerald-400">$</span> astro check &amp;&amp; astro build
              </div>
              <div class="text-emerald-400 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>[build] 8 client sites deployed flawlessly</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECH STACK & TOOLS SECTION -->
  <section class="py-12 border-y border-slate-800/80 bg-slate-950/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold mb-1">
          Ecosystem &amp; Tooling
        </h2>
        <p class="text-xl font-bold text-white">Fondasi Kerja &amp; Model AI Favorit</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 font-mono text-center">
        <!-- Astro JS -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-cyan-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">rocket_launch</span>
          </div>
          <div class="font-bold text-white text-xs">Astro JS</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Core Engine</div>
        </div>

        <!-- OpenCode -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-emerald-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">terminal</span>
          </div>
          <div class="font-bold text-white text-xs">OpenCode</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Agent Harness</div>
        </div>

        <!-- Gemini -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-blue-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">auto_awesome</span>
          </div>
          <div class="font-bold text-white text-xs">Gemini</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Context &amp; Speed</div>
        </div>

        <!-- DeepSeek -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-indigo-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">psychology</span>
          </div>
          <div class="font-bold text-white text-xs">DeepSeek</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Deep Reasoning</div>
        </div>

        <!-- Tailwind CSS -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-sky-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">palette</span>
          </div>
          <div class="font-bold text-white text-xs">Tailwind CSS</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Precision Styling</div>
        </div>

        <!-- Linux / Arch -->
        <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 hover:border-cyan-500/40 transition-colors">
          <div class="w-8 h-8 mx-auto mb-2 text-amber-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">memory</span>
          </div>
          <div class="font-bold text-white text-xs">Linux Host</div>
          <div class="text-[10px] text-slate-400 mt-0.5">Native Workflow</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PORTFOLIO SECTION -->
  <section class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold">
            Hasil Karya &amp; Produksi
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Portofolio Unggulan</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-xl">
            Koleksi website riil yang dirancang dengan standar performa tinggi, silo SEO, dan kecepatan loading kilat.
          </p>
        </div>
        <a
          href="/portfolio"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono text-cyan-400 hover:text-cyan-300 font-semibold group self-start sm:self-auto"
        >
          <span>Lihat Semua 8 Project</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- RECENT ARTICLES SECTION -->
  <section class="py-16 sm:py-20 border-t border-slate-800/80 bg-slate-950/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold">
            Eksplorasi &amp; Catatan
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Artikel Terbaru</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Wawasan seputar vibe coding, AI Agent, arsitektur web modern, dan pengalaman teknis.
          </p>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono text-cyan-400 hover:text-cyan-300 font-semibold group self-start sm:self-auto"
        >
          <span>Semua Artikel</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
