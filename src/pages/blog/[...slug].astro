---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.publishDate);
---

<BaseLayout
  title={`${post.data.title} · Boim`}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <!-- Back Button -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-mono text-cyan-400 hover:text-cyan-300 mb-8 group"
    >
      <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Kembali ke Blog</span>
    </a>

    <!-- Article Header -->
    <header class="space-y-4 border-b border-slate-800/80 pb-8 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-400 font-semibold uppercase">
          {post.data.category}
        </span>
        <time datetime={post.data.publishDate.toISOString()} class="text-slate-400">
          {formattedDate}
        </time>
        <span class="text-slate-400">•</span>
        <span class="text-slate-400">Oleh {post.data.author}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
        {post.data.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {post.data.tags.map((tag) => (
          <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-slate-400">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Markdown Article Body -->
    <div class="markdown-content">
      <Content />
    </div>

    <!-- Author Bio Box -->
    <footer class="mt-16 pt-8 border-t border-slate-800/80">
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800/80 flex flex-col sm:flex-row items-center gap-5">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/30 border border-cyan-500/40 p-2 flex-shrink-0">
          <img src="/icon.svg" alt="Boim" class="w-full h-full object-contain filter invert opacity-90" />
        </div>
        <div class="space-y-1 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <span class="font-bold text-white text-base">Boim (boimthinks)</span>
            <span class="text-[10px] font-mono text-cyan-400 px-2 py-0.5 rounded bg-cyan-950 border border-cyan-800/60">Vibe Coder</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Software developer & praktisi AI Agent yang berbasis di Palembang. Suka mengeksplorasi ekosistem Astro JS, OpenCode, dan model penalaran komputasional modern.
          </p>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
