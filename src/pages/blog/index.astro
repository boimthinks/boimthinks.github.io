---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Blog & Catatan Teknis · Boim"
  description="Catatan eksplorasi teknis seputar vibe coding, AI Agent, arsitektur Astro JS, dan model penalaran komputasional."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <!-- Header -->
    <div class="mb-12 border-b border-slate-800/80 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 text-xs font-mono mb-4">
        <span>WRITINGS &amp; FIELD NOTES</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Blog &amp; Catatan Teknis
      </h1>
      <p class="text-slate-400 mt-3 text-sm sm:text-base leading-relaxed max-w-2xl">
        Kumpulan pemikiran, tutorial, dan dokumentasi pengalaman nyata seputar vibe coding, arsitektur AI agent, dan ekosistem Astro JS di lingkungan produksi.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
