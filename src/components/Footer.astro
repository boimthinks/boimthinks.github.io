---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-900 bg-slate-950/90 text-slate-400 py-12 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1 -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="font-mono font-bold text-white tracking-tight">boim<span class="text-cyan-400">.thinks</span></span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-cyan-950/70 border border-cyan-800/60 text-cyan-400 font-mono">vibe coder</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-md">
          Eksplorasi pembuatan website performa tinggi dengan arsitektur Astro JS, orkestrasi AI Agent via OpenCode, serta model penalaran Gemini & DeepSeek.
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Palembang, Sumatera Selatan, Indonesia</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-xs font-mono font-semibold text-slate-200 uppercase tracking-wider mb-3">Navigasi</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-cyan-400 transition-colors">Beranda</a></li>
          <li><a href="/about" class="hover:text-cyan-400 transition-colors">Tentang Saya</a></li>
          <li><a href="/portfolio" class="hover:text-cyan-400 transition-colors">Portofolio Web</a></li>
          <li><a href="/blog" class="hover:text-cyan-400 transition-colors">Artikel & Catatan</a></li>
        </ul>
      </div>

      <!-- Col 3: AI & Feeds -->
      <div>
        <h3 class="text-xs font-mono font-semibold text-slate-200 uppercase tracking-wider mb-3">AI & Protocol</h3>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href="/llms.txt" class="text-cyan-400 hover:text-cyan-300 flex items-center gap-1.5 transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              /llms.txt
            </a>
          </li>
          <li>
            <a href="https://github.com/boimthinks" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors">
              github.com/boimthinks
            </a>
          </li>
          <li>
            <a href="mailto:boim.koe@gmail.com" class="hover:text-slate-200 transition-colors">
              boim.koe@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-slate-900/90 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400 font-mono">
      <p>© {year} Boim. All rights reserved.</p>
      <div class="flex items-center gap-2 text-slate-400">
        <span>Powered by Astro JS & Tailwind CSS</span>
        <span>•</span>
        <span class="text-cyan-400">Engineered with OpenCode</span>
      </div>
    </div>
  </div>
</footer>
